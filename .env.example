# Point d'entrée de l'application, lu par la CLI Litestar.
# Requis : l'autodiscovery ne cherche que app.py/application.py à la racine.
LITESTAR_APP=backend.app:app

# Clé attendue par le guard de /api/hello. nginx l'injecte côté serveur en
# production, le proxy Vite en développement : elle n'entre jamais dans le bundle.
# Requise : sans elle, la route refuse tout et `docker compose up` s'arrête.
API_KEY=dev-only-change-me

# URL du backend, lue par litestar-vite-plugin pour son diagnostic de dev.
# Sans elle, le dev server affiche un avertissement « backend absent » trompeur.
APP_URL=http://127.0.0.1:8000

# Sert la documentation OpenAPI sur /schema (Swagger, Redoc, openapi.json).
# Lu par backend/__init__.py. Défaut : true, désactivé dans compose.prod.yml,
# car /schema publie l'inventaire complet des routes.
#ENABLE_DOCS=false

# Nombre de workers Granian, lu par la CLI. C'est le levier de dimensionnement
# vertical de l'API. Défaut : 1
#WEB_CONCURRENCY=4

# Port du dev server Vite. Lu par frontend/vite.config.ts. Défaut : 5173
#VITE_PORT=5173

# Cible du proxy /api du dev server Vite, si l'API n'écoute pas sur le port
# habituel. Lu par frontend/vite.config.ts. Défaut : http://127.0.0.1:8000
#API_URL=http://127.0.0.1:8000

# Identifiant du client OpenPanel, injecté dans le bundle au build. Absent, la
# mesure d'audience ne démarre pas : un développement local ne pollue pas les
# chiffres de production. Lu par frontend/src/main.ts.
#VITE_OPENPANEL_CLIENT_ID=

# L'instance OpenPanel auto hébergée vers laquelle nginx relaie /api/op. Côté
# serveur uniquement : l'adresse n'entre jamais dans le bundle, donc un bloqueur
# n'a aucun domaine à reconnaître. Lu par deploy/default.conf.template.
#OPENPANEL_API=https://opapi.athroniaeth.cloud
